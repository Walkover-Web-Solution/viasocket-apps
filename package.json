{
  "name": "viasocket-apps",
  "version": "0.12.2",
  "description": "viaSocket for your product and your coding agent: let your users connect any of 2,300+ apps, run actions and react to events; an AI assistant on any model with your endpoints as tools; AI memory per user; login, teams and organisations; automations per user; plus the skill for building your own automations and plugs on viaSocket, and `npx viasocket-apps login`.",
  "keywords": [
    "viasocket",
    "integrations",
    "automation",
    "ai-agent",
    "ai-memory",
    "login",
    "oauth",
    "api",
    "webhooks",
    "slack",
    "github",
    "google-sheets",
    "agent-skill",
    "langchain"
  ],
  "license": "MIT",
  "author": "Walkover Web Solution",
  "homepage": "https://github.com/Walkover-Web-Solution/viasocket-apps#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Walkover-Web-Solution/viasocket-apps.git"
  },
  "bugs": {
    "url": "https://github.com/Walkover-Web-Solution/viasocket-apps/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./browser": {
      "types": "./dist/esm/browser.d.ts",
      "import": "./dist/esm/browser.js",
      "require": "./dist/cjs/browser.js"
    },
    "./langchain": {
      "types": "./dist/esm/langchain.d.ts",
      "import": "./dist/esm/langchain.js",
      "require": "./dist/cjs/langchain.js"
    }
  },
  "bin": {
    "viasocket-apps": "bin/viasocket.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finish-build.mjs",
    "test": "npm run build && node --test test/token.test.mjs test/client.test.mjs test/browser.test.mjs test/cli.test.mjs test/langchain.test.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.1",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    }
  }
}
